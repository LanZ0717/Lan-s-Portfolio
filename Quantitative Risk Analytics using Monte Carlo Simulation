        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "import os\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "data_path = '/content/drive/MyDrive/CRA/Assignment 2'\n",
        "\n",
        "# 1. read raw data\n",
        "financials_raw = pd.read_parquet(f'{data_path}/compustat financials.parquet')\n",
        "ratings_raw = pd.read_parquet(f'{data_path}/S&P ratings.parquet')\n",
        "\n",
        "\n",
        "# 2. convert dates\n",
        "financials_raw['data_date'] = pd.to_datetime(financials_raw['data_date'])\n",
        "ratings_raw['date'] = pd.to_datetime(ratings_raw['date'])\n",
        "ratings_raw['end_date'] = pd.to_datetime(ratings_raw['end_date'])\n",
        "\n",
        "# 3. build default date\n",
        "default_symbols = ['D', 'SD']\n",
        "default_dates = (\n",
        "    ratings_raw[ratings_raw['rtg_symbol'].isin(default_symbols)]\n",
        "    .groupby('gvkey', as_index=False)['date']\n",
        "    .min()\n",
        "    .rename(columns={'date': 'default_date'})\n",
        ")\n",
        "\n",
        "# 4. merge into financials\n",
        "financials = financials_raw.merge(default_dates, on='gvkey', how='left')\n",
        "financials['default_date'] = financials['default_date'].fillna(pd.Timestamp('2100-12-31'))\n",
        "\n",
        "# 5. build default flag: default within 1 year after data_date\n",
        "financials['default_flag'] = (\n",
        "    (financials['default_date'] > financials['data_date']) &\n",
        "    (financials['default_date'] <= financials['data_date'] + pd.DateOffset(years=1))\n",
        ").astype(int)\n",
        "\n",
        "# 6. sort and create lagged asset\n",
        "financials = financials.sort_values(['gvkey', 'data_date']).copy()\n",
        "financials['at_lag'] = financials.groupby('gvkey')['at'].shift(1)\n",
        "\n",
        "def safe_div(num, den):\n",
        "    den = den.astype(float)\n",
        "    num = num.astype(float)\n",
        "    return np.where((den == 0) | den.isna(), np.nan, num / den)\n",
        "\n",
        "# 7. basic building blocks\n",
        "financials['total_debt'] = financials['dlc'].fillna(0) + financials['dltt'].fillna(0)\n",
        "financials['tangible_assets'] = financials['at'] - financials['intan'].fillna(0) - financials['gdwl'].fillna(0)\n",
        "financials['free_cash_flow'] = financials['oancf'].fillna(0) - financials['capx'].fillna(0)\n",
        "\n",
        "# 8. factors\n",
        "financials['roa'] = safe_div(financials['ni'], financials['at'])\n",
        "financials['net_profit_margin'] = safe_div(financials['ni'], financials['sale'])\n",
        "financials['interest_coverage'] = safe_div(financials['ebit'], financials['xint'])\n",
        "financials['fcrr'] = safe_div(financials['oibdp'], financials['xint'].fillna(0) + financials['dv'].fillna(0))\n",
        "financials['dscr'] = safe_div(financials['oancf'], financials['xint'].fillna(0) + financials['dlc'].fillna(0))\n",
        "financials['ocf_to_debt'] = safe_div(financials['oancf'], financials['total_debt'])\n",
        "financials['fcf_to_debt'] = safe_div(financials['free_cash_flow'], financials['total_debt'])\n",
        "financials['ceq_to_assets'] = safe_div(financials['ceq'], financials['at'])\n",
        "financials['debt_to_tang_assets'] = safe_div(financials['total_debt'], financials['tangible_assets'])\n",
        "financials['debt_to_assets'] = safe_div(financials['total_debt'], financials['at'])\n",
        "financials['dividends_tos'] = safe_div(financials['dv'], financials['sale'])\n",
        "financials['current_ratio'] = safe_div(financials['act'], financials['lct'])\n",
        "financials['current_assets_toa'] = safe_div(financials['act'], financials['at'])\n",
        "financials['cash_short_inv_toa'] = safe_div(financials['che'], financials['at'])\n",
        "financials['op_inc_b4_dep_tos'] = safe_div(financials['oibdp'], financials['sale'])\n",
        "financials['op_cash_flow_tos'] = safe_div(financials['oancf'], financials['sale'])\n",
        "financials['operating_margin'] = safe_div(financials['ebit'], financials['sale'])\n",
        "financials['rsch_devel_toa'] = safe_div(financials['xrd'], financials['at'])\n",
        "financials['goodwill_to_assets'] = safe_div(financials['gdwl'], financials['at'])\n",
        "financials['accruals'] = safe_div(financials['ni'] - financials['oancf'], financials['at'])\n",
        "financials['asset_growth'] = safe_div(financials['at'] - financials['at_lag'], financials['at_lag'])\n",
        "\n",
        "# size / level variables\n",
        "financials['total_assets'] = financials['at']\n",
        "financials['debt_value_toa'] = safe_div(financials['total_debt'], financials['at'])\n",
        "\n",
        "# 9. factor list\n",
