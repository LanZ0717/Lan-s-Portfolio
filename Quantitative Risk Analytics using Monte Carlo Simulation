        "# Step 2 - Factor Comparison by Default Status"
      ],
      "metadata": {
        "id": "JKYoBSNfn4P6"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Step 2\n",
        "# Each factor's median and mean\n",
        "tables = []\n",
        "\n",
        "for factor in list_of_factors:\n",
        "    a = financials[[factor, 'default_flag']].copy()\n",
        "    a[factor] = pd.to_numeric(a[factor], errors='coerce')\n",
        "    a = a[~np.isnan(a[factor])]\n",
        "    a = a[(a[factor] != np.inf) & (a[factor] != -np.inf)]\n",
        "\n",
        "    if len(a) == 0:\n",
        "        continue\n",
        "\n",
        "    mean_0 = a[a.default_flag == 0][factor].mean()\n",
        "    mean_1 = a[a.default_flag == 1][factor].mean()\n",
        "    median_0 = a[a.default_flag == 0][factor].median()\n",
        "    median_1 = a[a.default_flag == 1][factor].median()\n",
        "\n",
        "    tables.append([\n",
        "        factor,\n",
        "        mean_0,\n",
        "        mean_1,\n",
        "        mean_1 - mean_0,\n",
        "        median_0,\n",
        "        median_1,\n",
        "        median_1 - median_0\n",
        "    ])\n",
        "\n",
        "step2_df = pd.DataFrame(\n",
        "    tables,\n",
        "    columns=[\n",
        "        'factor',\n",
        "        'mean_default_0',\n",
        "        'mean_default_1',\n",
        "        'mean_diff',\n",
        "        'median_default_0',\n",
        "        'median_default_1',\n",
        "        'median_diff'\n",
        "    ]\n",
        ")\n",
        "\n",
        "step2_df_rounded = step2_df.copy()\n",
        "\n",
        "for c in step2_df_rounded.columns[1:]:\n",
        "    step2_df_rounded[c] = step2_df_rounded[c].round(4)\n",
        "\n",
        "step2_df_rounded"
      ],
