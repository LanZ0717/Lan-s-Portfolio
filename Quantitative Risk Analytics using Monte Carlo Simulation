        "# Step 1\n",
        "# Define the best model for the factor\n",
        "from sklearn.metrics import roc_auc_score\n",
        "\n",
        "def search_best_model(financials, combos, threshold=0.5):\n",
        "    combos_tested = []\n",
        "\n",
        "    for combo in combos:\n",
        "        data_ = financials[['gvkey', 'default_flag', 'fold'] + combo].copy()\n",
        "\n",
        "        for c in combo:\n",
        "            data_[c] = pd.to_numeric(data_[c], errors='coerce')\n",
        "\n",
        "        data_ = data_.dropna()\n",
        "        data_ = data_[np.isfinite(data_[combo]).all(axis=1)]\n",
        "\n",
        "        if len(data_) == 0:\n",
        "            continue\n",
        "\n",
        "        if has_high_corr_pair(data_[combo], threshold=threshold):\n",
        "            continue\n",
        "\n",
        "        test = data_[data_.fold == 'test']\n",
        "        cv = data_[data_.fold != 'test']\n",
        "\n",
        "        if len(test) == 0 or len(cv) == 0:\n",
        "            continue\n",
        "\n",
        "        fold_val_aucs = []\n",
        "        fold_train_aucs = []\n",
        "\n",
        "        for fold in range(4):\n",
        "            train = cv[cv.fold != fold]\n",
        "            val = cv[cv.fold == fold]\n",
        "\n",
        "            if len(train) == 0 or len(val) == 0:\n",
        "                continue\n",
        "            if train.default_flag.nunique() < 2 or val.default_flag.nunique() < 2:\n",
        "                continue\n",
        "\n",
        "            X_train, y_train = train[combo], train.default_flag\n",
        "            X_val, y_val = val[combo], val.default_flag\n",
        "\n",
        "            dflt_pct = y_train.mean()\n",
        "            if dflt_pct == 0 or dflt_pct == 1:\n",
        "                continue\n",
        "\n",
        "            weight_dflt = (1 - dflt_pct) / dflt_pct\n",
        "            class_weight = {0: 1, 1: weight_dflt}\n",
        "\n",
        "            try:\n",
        "                logit_model = build_logit_model(class_weight)\n",
        "                logit_model.fit(X_train, y_train)\n",
        "\n",
        "                yhat_val = logit_model.predict_proba(X_val)[:, 1]\n",
        "                yhat_train = logit_model.predict_proba(X_train)[:, 1]\n",
        "\n",
        "                fold_val_aucs.append(roc_auc_score(y_val, yhat_val))\n",
        "                fold_train_aucs.append(roc_auc_score(y_train, yhat_train))\n",
        "            except:\n",
        "                pass\n",
        "\n",
        "        if fold_val_aucs:\n",
        "            avg_val = np.mean(fold_val_aucs)\n",
        "            avg_train = np.mean(fold_train_aucs)\n",
        "            combos_tested.append([avg_val, avg_train, combo])\n",
        "\n",
        "    if not combos_tested:\n",
        "        return None\n",
        "\n",
        "    combos_tested = sorted(combos_tested, key=lambda x: x[0])\n",
        "    best = combos_tested[-1]\n",
        "    best_combo = best[2]\n",
        "\n",
        "    cv_data = financials[['default_flag', 'fold'] + best_combo].copy()\n",
        "    for c in best_combo:\n",
        "        cv_data[c] = pd.to_numeric(cv_data[c], errors='coerce')\n",
        "    cv_data = cv_data.dropna()\n",
        "    cv_data = cv_data[np.isfinite(cv_data[best_combo]).all(axis=1)]\n",
        "\n",
        "    train_data = cv_data[cv_data.fold != 'test']\n",
        "    test_data = cv_data[cv_data.fold == 'test']\n",
        "\n",
        "    dflt_pct = train_data.default_flag.mean()\n",
        "    weight_dflt = (1 - dflt_pct) / dflt_pct\n",
        "    class_weight = {0: 1, 1: weight_dflt}\n",
        "\n",
        "    logit_model = build_logit_model(class_weight)\n",
        "    logit_model.fit(train_data[best_combo], train_data.default_flag)\n",
        "\n",
        "    auc_test = roc_auc_score(\n",
        "        test_data.default_flag,\n",
        "        logit_model.predict_proba(test_data[best_combo])[:, 1]\n",
        "    )\n",
        "    auc_train = roc_auc_score(\n",
        "        train_data.default_flag,\n",
        "        logit_model.predict_proba(train_data[best_combo])[:, 1]\n",
        "    )\n",
        "\n",
        "    return {\n",
        "        'best_combo': best_combo,\n",
        "        'validation_auc': best[0],\n",
        "        'train_auc': auc_train,\n",
        "        'test_auc': auc_test,\n",
        "        'num_combos_tested': len(combos_tested)\n",
        "    }"
      ],
