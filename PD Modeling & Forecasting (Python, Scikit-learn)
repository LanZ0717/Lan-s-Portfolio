        "# Monte Carlo pricer + Greeks for a 1Y European call with K=120% * S0\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "def mc_call_price_terminal(S0, K, r, sigma, T, Z, use_antithetic=True):\n",
        "    \"\"\"\n",
        "    Price a European call using terminal distribution under GBM.\n",
        "    Reuses the same normal draws Z (CRN). If use_antithetic=True,\n",
        "    augment with antithetic variates to reduce variance.\n",
        "    \"\"\"\n",
        "    drift = (r - 0.5 * sigma**2) * T\n",
        "    vol = sigma * np.sqrt(T)\n",
        "\n",
        "    ST = S0 * np.exp(drift + vol * Z)\n",
        "    payoff = np.maximum(ST - K, 0.0)\n",
        "\n",
        "    if use_antithetic:\n",
        "        ST_a = S0 * np.exp(drift - vol * Z)  # antithetic: use - Z\n",
        "        payoff_a = np.maximum(ST_a - K, 0.0)\n",
        "        payoff = 0.5 * (payoff + payoff_a)\n",
        "\n",
        "    price = np.exp(-r * T) * np.mean(payoff)\n",
        "    stderr = np.exp(-r * T) * np.std(payoff, ddof = 1) / np.sqrt(payoff.size)\n",
        "    return price, stderr\n",
        "\n",
        "def greeks_mc(S0 = 100.0, sigma = 0.16, r = 0.02, T = 1.0, K_ratio = 1.20,\n",
        "              n_paths = 200_000, eps_pct = 0.01, vega_bump = 0.01, seed = 7):\n",
        "    \"\"\"\n",
        "    Returns MC estimates for price, (Delta, Gamma, Vega) using CRN and central differences.\n",
        "    - eps_pct: relative S bump (e.g., 0.01 = 1%)\n",
        "    - vega_bump: absolute vol point bump (e.g., 0.01 = +1 vol point)\n",
        "    \"\"\"\n",
        "    rng = np.random.default_rng(seed)\n",
        "    Z = rng.standard_normal(n_paths)  # common random numbers\n",
        "\n",
        "    K = K_ratio * S0\n",
        "\n",
        "    # Base price\n",
        "    P0, se0 = mc_call_price_terminal(S0, K, r, sigma, T, Z)\n",
        "\n",
        "    # Spot bumps (central difference)\n",
        "    hS  = eps_pct * S0\n",
        "    Pup, _ = mc_call_price_terminal(S0 + hS, K, r, sigma, T, Z)\n",
        "    Pdn, _ = mc_call_price_terminal(S0 - hS, K, r, sigma, T, Z)\n",
        "    delta  = (Pup - Pdn) / (2.0 * hS)\n",
        "    gamma  = (Pup - 2.0 * P0 + Pdn) / (hS**2)\n",
        "\n",
        "    # Vol bumps (central difference) — absolute vol points\n",
        "    v = vega_bump\n",
        "    Pvu, _ = mc_call_price_terminal(S0, K, r, sigma + v, T, Z)\n",
        "    Pvd, _ = mc_call_price_terminal(S0, K, r, sigma - v, T, Z)\n",
        "    vega   = (Pvu - Pvd) / (2.0 * v)\n",
        "\n",
        "    return {\n",
        "        \"inputs\": dict(S0=S0, sigma=sigma, r=r, T=T, K=K),\n",
        "        \"n_paths\": n_paths,\n",
        "        \"price\": P0, \"price_se\": se0,\n",
        "        \"delta\": delta, \"gamma\": gamma, \"vega\": vega,\n",
        "        \"settings\": {\"eps_pct\": eps_pct, \"vega_bump\": vega_bump, \"seed\": seed}\n",
        "    }\n",
        "\n",
        "# ---- Example: 1Y, K=120% ----\n",
        "if __name__ == \"__main__\":\n",
