        "import numpy as np\n",
        "\n",
        "# ---- Monte Carlo pricer: terminal-only (fast for European) ----\n",
        "def mc_call_price_terminal(S0, K, r, sigma, T, Z, use_antithetic = True):\n",
        "    \"\"\"\n",
        "    Price a European call under risk-neutral GBM using terminal distribution.\n",
        "    Z: standard normal draws (common random numbers across revaluations).\n",
        "    \"\"\"\n",
        "    drift = (r - 0.5 * sigma**2) * T\n",
        "    vol   = sigma * np.sqrt(T)\n",
        "\n",
        "    ST  = S0 * np.exp(drift + vol * Z)\n",
        "    pay = np.maximum(ST - K, 0.0)\n",
        "\n",
        "    if use_antithetic:\n",
        "        STa  = S0 * np.exp(drift - vol * Z)  # antithetic\n",
        "        paya = np.maximum(STa - K, 0.0)\n",
        "        pay  = 0.5 * (pay + paya)\n",
        "\n",
        "    return np.exp(-r * T) * np.mean(pay)\n",
        "\n",
        "def gamma_mc(S0, K, r, sigma, T, Z, h_pct=0.01):\n",
        "    \"\"\"\n",
        "    Dollar Gamma via central difference with relative spot bump h_pct.\n",
        "    Gamma ≈ [P(S(1+h)) - 2P(S) + P(S(1-h))] / (hS)^2\n",
        "    \"\"\"\n",
        "    hS  = h_pct * S0\n",
        "    P0  = mc_call_price_terminal(S0,      K, r, sigma, T, Z)\n",
        "    Pup = mc_call_price_terminal(S0+hS,   K, r, sigma, T, Z)\n",
        "    Pdn = mc_call_price_terminal(S0-hS,   K, r, sigma, T, Z)\n",
        "    return (Pup - 2.0*P0 + Pdn) / (hS**2)\n",
        "\n",
        "# ---- Inputs (feel free to change) ----\n",
        "S0    = 100.0        # spot\n",
        "sigma = 0.16         # annual vol\n",
        "r     = 0.00         # risk-free rate\n",
        "K     = 1.20 * S0    # 120% strike\n",
        "days_in_year = 252\n",
        "\n",
        "T_30d = 30 / days_in_year\n",
        "T_10d = 10 / days_in_year\n",
        "\n",
        "# ---- Common random numbers ----\n",
        "rng = np.random.default_rng(2025)\n",
        "Z   = rng.standard_normal(300_000)  # number of paths\n",
        "\n",
        "# ---- Gamma estimates ----\n",
        "gamma_30d = gamma_mc(S0, K, r, sigma, T_30d, Z, h_pct=0.01)\n",
        "gamma_10d = gamma_mc(S0, K, r, sigma, T_10d, Z, h_pct=0.01)\n",
        "\n",
        "print(f\"Gamma (30 days to maturity): {gamma_30d:.8f}\")\n",
        "print(f\"Gamma (10 days to maturity): {gamma_10d:.8f}\")"
